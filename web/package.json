    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.5.28",
    "supabase": "^2.117.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
