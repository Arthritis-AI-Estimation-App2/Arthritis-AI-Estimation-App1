# ローカルSupabase（npx supabase start 後、npx supabase status の値を使う）
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key（sb_publishable_...）
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key（sb_secret_...）。サーバー専用
SUPABASE_SECRET_KEY=

# ホスト済みプロジェクトを使う場合は URL を https://<project-ref>.supabase.co に変える
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# AI推論API（未設定ならモック）
AI_API_URL=
# サーバー専用。NEXT_PUBLIC_を付けない
AI_API_KEY=
# APIの成功レスポンスをNext.jsサーバーログへ1行JSONで出力する（機微情報に注意）
AI_API_LOG_RESPONSE=false

# ダークモード（未設定またはfalseならライトモード固定）
ENABLE_DARK_MODE=false

# 任意。専用のリモートテストプロジェクトを使うときだけ設定する。
# 未設定なら、上の URL がローカルのときだけ RLS テストが同じ値を使う。
# TEST_SUPABASE_URL=
# TEST_SUPABASE_PUBLISHABLE_KEY=
# TEST_SUPABASE_SECRET_KEY=
